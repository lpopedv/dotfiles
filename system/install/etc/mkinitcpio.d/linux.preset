# Emits a UKI instead of a vmlinuz+initramfs pair: the pair can't be signed
# safely since the initramfs arrives unverified over the EFI initrd protocol.
ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default')

# No default_image: would leave an unsigned initramfs only the retired entry uses.
default_uki="/boot/EFI/Linux/arch-linux.efi"

default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"
