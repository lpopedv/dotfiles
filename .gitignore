# Kubeconfigs carry cluster credentials and this repo is public; never let one be committed.
.kube/

# Generated by system/iso/build.sh; a copy here is stale, never source it.
.iso-revision

# Runtime debug logs written by herdr keybinding scripts.
herdr/.config/herdr/scripts/*.log

# herdr's own runtime state: session snapshots, client/server logs, plugin lock.
# Regenerated locally on every run, not source.
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/
herdr/.config/herdr/.plugins.lock
