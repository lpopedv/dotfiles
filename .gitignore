.tmp*

# English learning data (personal progress — kept local, not versioned)
claude/.claude/english/log.jsonl
claude/.claude/english/reviews/

# archinstall drops these in the working directory when it cannot write
# to /var/log/archinstall, which is what happens on a --dry-run as non-root
install.log
cmd_history.txt

# Built ISOs - multi-GB artifacts, rebuilt from iso/build.sh
iso/out/

# systemctl --user enable writes here because stow symlinks
# ~/.config/systemd/user into this repo - it's runtime enable-state,
# regenerated by bootstrap.sh, not source config
systemd/.config/systemd/user/*.wants/
