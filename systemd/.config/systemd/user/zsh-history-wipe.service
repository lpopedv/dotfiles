[Unit]
Description=Wipe zsh history periodically

[Service]
Type=oneshot
# Only guarantees empty at wipe time - SHARE_HISTORY lets an already-open shell rewrite it on exit.
ExecStart=/usr/bin/truncate -s 0 %h/.zsh_history

# Sandboxed: read-only filesystem except this one file.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.zsh_history
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
